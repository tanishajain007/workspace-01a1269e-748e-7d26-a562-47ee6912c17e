{
  "name": "gemini-chat",
  "version": "1.0.0",
  "private": true,
  "description": "Gemini free-tier chatbot built with plain HTML, CSS and JavaScript — no build step, no runtime dependencies.",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "test": "node --test tests/",
    "test:unit": "node --test tests/app.test.mjs",
    "test:dom": "node --test tests/dom.test.mjs",
    "test:server": "node --test tests/server.test.mjs",
    "serve:python": "python3 -m http.server 8000"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
